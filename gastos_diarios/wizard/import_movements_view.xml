<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>

        <record id="view_gastos_diarios_import_movement" model="ir.ui.view">
            <field name="name">Importar movimientos</field>
            <field name="model">gastos.diarios.import.movement</field>

            <field name="arch" type="xml">
                <form string="Importar movimientos" version="7.0">
                    <group colspan="4" col="4" states="choose">
                        <field name="data" colspan="4"/>
                    </group>
                    <footer states="choose">
                        <button special="cancel" string="Cancelar" icon='gtk-cancel'/>
                        <button name="import_movements" string="Procesar" type="object" icon="gtk-execute"/>
                        <field invisible="1" name="state"/>
                    </footer>
                    <group colspan="4" col="4" states="done">
                        <separator string="Fin del proceso" colspan="4"/>
                        <field name="info" colspan="4" nolabel="1"/>
                    </group>
                    <footer states="done">
                        <button special="cancel" icon="gtk-cancel" string="Cerrar"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_gastos_diarios_import_movement" model="ir.actions.act_window">
            <field name="name">Importar movimientos</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">gastos.diarios.import.movement</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>


    </data>
</openerp>
